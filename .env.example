# --- Claude API (fact generation + fact-check) ---
ANTHROPIC_API_KEY=sk-ant-...
# Sonnet-tier per architecture doc; override if desired
CLAUDE_MODEL=claude-sonnet-4-6

# --- DeepSeek (cheap A/B fact generation — music account) ---
# Half of historical-pillar posts (DEEPSEEK_SHARE) are written by DeepSeek from
# its own knowledge instead of the Claude+web_search flow; recent_news is
# grounded via Tavily (below) and written by DeepSeek. Leave key blank to keep
# everything on the Claude path. NOTE: deepseek-chat deprecates 2026-07-24 —
# after that set DEEPSEEK_MODEL=deepseek-v4-flash.
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-chat
# Fraction (0..1) of historical-pillar posts routed to DeepSeek; rest go to Claude.
DEEPSEEK_SHARE=0.5

# --- Tavily search (grounds the recent_news pillar) ---
# Free tier: 1,000 searches/month, no card. Blank => recent_news falls back to Claude.
TAVILY_API_KEY=tvly-...
# Per-search price for cost metrics; 0 while within the free tier.
TAVILY_PRICE_USD=0
# Optional comma-separated outlet whitelist for recent_news (keeps results on
# electronic-music press). Unset => built-in RECENT_NEWS_DOMAINS list in
# generateFact.js. Tighten (e.g. drop billboard.com/pitchfork.com) to cut pop noise.
# TAVILY_INCLUDE_DOMAINS=residentadvisor.net,mixmag.net,djmag.com,factmag.com

# --- Grok / xAI (cover image generation) ---
XAI_API_KEY=xai-...
GROK_IMAGE_MODEL=grok-2-image

# Testing: path to a local image file to use as the cover instead of calling
# the xAI API (jpg/png/webp/svg/gif). Leave unset for normal operation.
LOCAL_COVER_IMAGE=

# --- Artist imagery policy ---
# "stylized" (default, recommended) or "photoreal" (legal/platform risk — see README)
ARTIST_IMAGE_MODE=stylized

# --- Human review gate ---
# true = every post must be approved via Telegram before publish
REVIEW_REQUIRED=true
TELEGRAM_BOT_TOKEN=123456:ABC-...
TELEGRAM_CHAT_ID=123456789

# --- Instagram Graph API ---
# Instagram Business/Creator account ID (not the username)
IG_USER_ID=17841400000000000
# Long-lived Page access token from your Meta developer app
META_ACCESS_TOKEN=EAAG...

# --- Media hosting ---
# The Instagram Graph API fetches carousel images by public URL.
# Serve the output/ dir publicly (npm run serve behind a reverse proxy, or a tunnel)
# and set the public base URL here, e.g. https://media.example.com
PUBLIC_MEDIA_BASE_URL=
MEDIA_SERVER_PORT=8787

# --- Storage / misc ---
DB_PATH=./data/state.db
OUTPUT_DIR=./output
POST_HANDLE=@electronic.music.facts

# --- AI cost & droplet-health dashboard (npm run metrics-server) ---
# Shared metrics store (all accounts write here so one dashboard sees everything).
# Deliberately not DB_PATH — leave the default so every account shares one file.
METRICS_DB_PATH=./data/metrics.db
# Dashboard HTTP port (binds 127.0.0.1; put Caddy + Basic auth in front).
METRICS_SERVER_PORT=8788
# Per-image price used to estimate Grok/xAI image cost. Verify against xAI pricing.
XAI_IMAGE_PRICE_USD=0.07

# ===========================================================================
# --- Telegram generation bot (npm run gen-bot) ---
# ===========================================================================
# Standalone service: send it a prompt, it offers a keyboard of generation
# agents annotated with what's left on each provider, and uploads the result
# back into the chat. Runs from its OWN env file (.env.genbot) with its own
# bot token, chat id and DB — nothing below is read by the content pipeline
# or the Facebook responder.
#
#   TELEGRAM_BOT_TOKEN=<a second bot from @BotFather>
#   TELEGRAM_CHAT_ID=<your chat id>
#   ACCOUNT=genbot
#   POST_HANDLE=genbot          # becomes the metrics dashboard's account label
#   DB_PATH=./data/genbot.db    # its own state; leave METRICS_DB_PATH default
#
# Agents appear on the keyboard only when their key is set, so configuring a
# provider is all it takes to enable one (see src/genbot/registry.js).

# OpenAI — gpt-image-1 images (and Sora video, once video agents land).
OPENAI_API_KEY=sk-...
OPENAI_IMAGE_MODEL=gpt-image-1
# OPTIONAL and different from the key above: only an admin key (sk-admin-...)
# can read the org Costs API, which is the only way to get a real spend figure
# out of OpenAI. Unset => OpenAI falls back to the budget estimate below.
OPENAI_ADMIN_KEY=

# Google Gemini — image generation (the vision model above is separate).
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_VIDEO_MODEL=veo-3.0-generate-001

# fal.ai — aggregator: one key and one prepaid balance covers FLUX, Ideogram,
# Kling and more, and it reports a real balance (most providers don't).
FAL_API_KEY=

# Dedicated video providers (v2). Both report credits rather than dollars, so
# the conversion rate is env-tunable — check your plan's actual rate.
RUNWAY_API_KEY=
RUNWAY_USD_PER_CREDIT=0.01
LUMA_API_KEY=
LUMA_USD_PER_CREDIT=0.0004

# --- Budgets: "how much money do I have with each agent" ---
# xAI, Google and (without an admin key) OpenAI expose NO balance API, so for
# those the bot shows what you declare here minus what this repo has spent
# since _BUDGET_SINCE. That estimate is blind to spend from the provider's own
# playground or any other app, so treat it as a floor — it's marked "~" in the
# UI. fal / Runway / Luma / DeepSeek report a real balance and ignore these.
# Unset => the bot shows spend only, with no "remaining" figure.
XAI_BUDGET_USD=
XAI_BUDGET_SINCE=2026-08-01
OPENAI_BUDGET_USD=
OPENAI_BUDGET_SINCE=2026-08-01
GEMINI_BUDGET_USD=
GEMINI_BUDGET_SINCE=2026-08-01
# ANTHROPIC_BUDGET_USD / FAL_BUDGET_USD / DEEPSEEK_BUDGET_USD / etc. work too.

# How long a live balance is reused before re-probing the provider.
BALANCE_CACHE_TTL_MS=60000

# --- Development ---
# true = stub Claude + Grok with canned data so the pipeline runs without API
# keys. Also makes the gen-bot offer every agent and return a labelled
# placeholder image, so the whole prompt -> pick -> upload loop is testable
# offline with no keys and no spend.
MOCK_MODE=false
